rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll(['name', 'score', 'wave', 'timestamp']) &&
             data.keys().hasOnly(['name', 'score', 'wave', 'timestamp']) &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 50 &&
             data.score is int && data.score >= 0 &&
             data.wave is int && data.wave >= 1 &&
             data.timestamp == request.time;
    }

    match /leaderboard/{entryId} {
      allow read: if true;
      allow create: if isValidId(entryId) && isValidLeaderboardEntry(request.resource.data);
      allow update, delete: if false;
    }
  }
}
