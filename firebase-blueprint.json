{
  "entities": {
    "LeaderboardEntry": {
      "title": "Leaderboard Entry",
      "description": "A score entry in the survival mode leaderboard",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "description": "The name of the player"
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "description": "The total score achieved"
        },
        "wave": {
          "type": "integer",
          "minimum": 1,
          "description": "The highest wave reached"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When the score was achieved"
        }
      },
      "required": ["name", "score", "wave", "timestamp"]
    }
  },
  "firestore": {
    "/leaderboard/{entryId}": {
      "schema": "LeaderboardEntry",
      "description": "Global leaderboard for survival mode"
    }
  }
}
